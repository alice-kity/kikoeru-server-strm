# Leave blank to generate an independent random admin password at first start.
# The generated value is written only to deploy/runtime/config/admin-password.
KIKOERU_ADMIN_PASSWORD=
# The upstream is pinned by digest; do not replace it with a moving tag.
KIKOERU_UPSTREAM_IMAGE=number17/kikoeru@sha256:e78de6e4ac3eb8dbddffc84b31b3f10b809cb2baf3944fd3a5bfe0e5daa77391
# Use a versioned/immutable local image tag.  Do not use :latest.
KIKOERU_STRM_IMAGE=kikoeru-strm:0.2.0
# Required: absolute host directory containing the 115 STRM library.
KIKOERU_STRM_MEDIA_DIR=
# Optional host port (default 12346).
KIKOERU_STRM_PORT=12346
# Required: the 115 STRM Helper allowlist, written as host[:port] with no
# scheme, path, query or fragment (for example: helper.internal:13258).
STRM_ALLOWED_HOSTS=
# STRM loudness always uses native read-only ebur128; its method is fixed.
# The CDN destination allowlist is fixed in the adapter and is not configurable
# through Compose.
# Observe Purpose/Sec-Purpose by default; use short-circuit only after proving
# those requests are disposable preload probes. Do not detect HEAD by default.
STRM_PRELOAD_GUARD_ENABLED=
STRM_PRELOAD_GUARD_MODE=
STRM_PRELOAD_GUARD_DETECT_HEAD=
# Helper HEAD resolver gate; defaults are one request at a time, 1000ms spacing,
# 30 starts/minute and 1800 starts/hour. These are conservative client policy,
# not published 115 service quotas.
STRM_REDIRECT_MAX_CONCURRENT=
STRM_REDIRECT_MIN_INTERVAL_MS=
STRM_REDIRECT_MAX_QUEUE=
STRM_REDIRECT_PER_MINUTE=
STRM_REDIRECT_PER_HOUR=
STRM_REDIRECT_CACHE_TTL_MS=
# 429 policy: resolver retries 1/2/4s plus jitter (max 60s), then limiter cools down.
STRM_REDIRECT_COOLDOWN_MS=
STRM_REDIRECT_SEVERE_COOLDOWN_MS=
STRM_REDIRECT_SEVERE_AFTER_429=
STRM_REDIRECT_MAX_429_RETRIES=
STRM_REDIRECT_RETRY_BASE_MS=
STRM_REDIRECT_RETRY_MAX_MS=
STRM_REDIRECT_RETRY_JITTER_MS=
